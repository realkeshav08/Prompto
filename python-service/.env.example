GEMINI_API_KEY=your_gemini_api_key_here
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=quickgpt

# Shared secret — must match INTERNAL_API_KEY in server/.env.
# When set, every AI endpoint rejects callers that don't present it.
INTERNAL_API_KEY=generate_a_long_random_string

# ─── Optional hardening knobs (safe defaults shown) ──────────────────────────
# Expose interactive API docs (/docs, /redoc, /openapi.json). Keep false in prod.
ENABLE_DOCS=false
# Per-request outbound timeout to Gemini (ms).
GEMINI_TIMEOUT_MS=30000
# MongoDB timeouts (ms).
MONGO_SERVER_SELECTION_MS=5000
MONGO_TIMEOUT_MS=20000
# Max request body size (bytes) accepted before rejecting with 413.
MAX_BODY_BYTES=2000000
# History guards: max recent turns kept, and per-message char cap.
MAX_HISTORY_MSGS=30
MAX_MSG_CHARS=12000
# Rate limits (requests/min; 0 disables). Per-user protects a tenant;
# global is a circuit breaker on API spend if the internal key leaks.
RAG_RATE_LIMIT_PER_MIN=30
GLOBAL_RATE_LIMIT_PER_MIN=1200
# Comma-separated browser CORS origins. Empty = no cross-origin (server-to-server).
ALLOWED_ORIGINS=
